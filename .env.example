# ── PatientVectorHub — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values before running make dev
# NEVER commit the .env file — it is in .gitignore

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pvh:pvh_local@localhost:5432/pvh
DATABASE_URL_SYNC=postgresql+psycopg2://pvh:pvh_local@localhost:5432/pvh

# ── Cache & Messaging ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For Aiven/managed Kafka, set these if required:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_USERNAME=YOUR_USERNAME
# KAFKA_PASSWORD=YOUR_PASSWORD
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SSL_CAFILE=path\\to\\ca.pem
# KAFKA_SSL_CERTFILE=path\\to\\service.cert
# KAFKA_SSL_KEYFILE=path\\to\\service.key

# ── Vector Stores ─────────────────────────────────────────────────────────────
VECTOR_BACKEND=weaviate
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_URL=
WEAVIATE_API_KEY=
QDRANT_HOST=localhost
# 6333 = REST port (what the client connects on by default). 6334 is
# gRPC — a separate port, not used unless prefer_grpc is set. This was
# wrong (6334) before Phase 6/ADR-013; QdrantStore didn't exist yet to
# expose the bug.
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=


# -- Embeddings ---------------------------------------------------------------
# EMBEDDING_PROVIDER selects which embedder ingestion/src/embeddings runs:
#   openai        - OpenAI text-embedding-3-large (default, ADR-009)
#   clinical_bert - Hugging Face-hosted NeuML/pubmedbert-base-embeddings (ADR-012)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_VERSION=text-embedding-3-large
# text-embedding-3-large is natively 3072-dim; OpenAI's `dimensions` param
# can shorten it via Matryoshka representation learning. 1536 keeps quality
# high (beats full-size ada-002 even at 256) while halving Qdrant/Weaviate
# storage vs. 3072. Changing this after vectors exist requires re-embedding.
EMBEDDING_DIMENSIONS=1536

# -- Clinical embedding server (ADR-012, EMBEDDING_PROVIDER=clinical_bert) ----
# Hugging Face-hosted, not a local container — no port to point at here.
# 1. Get a token (Write access) at https://huggingface.co/settings/tokens
# 2. python scripts/deploy_hf_embedding_endpoint.py create
# 3. Paste the printed URL into HF_EMBEDDING_ENDPOINT_URL below
HF_TOKEN=
HF_EMBEDDING_ENDPOINT_URL=
HF_EMBEDDING_ENDPOINT_NAME=pvh-clinical-embeddings
CLINICAL_BERT_MODEL_ID=NeuML/pubmedbert-base-embeddings
CLINICAL_BERT_DIMENSIONS=768

# -- PHI guardrail (ADR-009, extended by ADR-012) ------------------------------
# Both embedding providers above send text to a third party's infrastructure,
# not our own VPC. Leave both false for synthetic-data development (the repo
# default). config.py's model_post_init refuses to boot if ALLOW_REAL_PHI=true
# without PHI_BAA_ACKNOWLEDGED=true also set, regardless of which provider.
ALLOW_REAL_PHI=false
PHI_BAA_ACKNOWLEDGED=false

# ── Vault ─────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
# In production: VAULT_TOKEN is NOT used — K8s ServiceAccount auth is used instead

# -- Auth ---------------------------------------------------------------------
AUTH_ENABLED=false

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8443
KEYCLOAK_REALM=patientvectorhub
KEYCLOAK_JWKS_URL=http://localhost:8443/realms/patientvectorhub/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8443/realms/patientvectorhub
KEYCLOAK_CLIENT_ID=pvh-spa

# ── LLM Providers (REQUIRED — get from provider dashboards) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
LLM_DEFAULT_PROVIDER=anthropic
LLM_MAX_TOKENS=1000

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DOCUMENT_BUCKET=pvh-documents-dev
R2_BACKUP_BUCKET=pvh-backups-dev

# ── Observability ─────────────────────────────────────────────────────────────
JAEGER_ENDPOINT=http://localhost:4317
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# ── App ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
