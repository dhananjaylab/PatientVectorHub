# dashboard/.env.example — copy to dashboard/.env.local for local dev.
#
# Vite only exposes vars prefixed VITE_ to client code (anything else in
# a .env file here is silently invisible to import.meta.env — not a bug,
# it's Vite's built-in guard against accidentally bundling server secrets
# into a browser payload). This file is intentionally separate from the
# repo-root .env / .env.example, which are api-gateway/ingestion/etc.'s
# server-side settings and are never read by the dashboard build.

# '/v1' (relative) works out of the box with vite.config.ts's dev-server
# proxy to localhost:8000. Production deploys must point this at the
# real API origin, e.g. https://api.pvh.internal/v1 — there is no proxy
# once this is a static build served by its own origin.
VITE_API_BASE_URL=/v1

# Mirrors api-gateway's AUTH_ENABLED (config.py, default false). Local
# dev default here is also false: with the backend's auth middleware not
# mounted, the dashboard can run and exercise every page without a
# Keycloak container — lib/keycloak.ts skips Keycloak entirely when this
# is false rather than trying to init against a realm that may not be
# running, matching AUTH_ENABLED's existing "unblock local iteration"
# purpose on the backend.
VITE_AUTH_ENABLED=false

# Keycloak — mirrors api-gateway/src/config.py's KEYCLOAK_BASE_URL /
# KEYCLOAK_REALM / KEYCLOAK_CLIENT_ID defaults and infra/keycloak/realm.json's
# pvh-spa public client (PKCE S256, standardFlowEnabled). Only read when
# VITE_AUTH_ENABLED=true.
VITE_KEYCLOAK_URL=http://localhost:8443
VITE_KEYCLOAK_REALM=patientvectorhub
VITE_KEYCLOAK_CLIENT_ID=pvh-spa
